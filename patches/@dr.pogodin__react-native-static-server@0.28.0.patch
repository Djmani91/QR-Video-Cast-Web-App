diff --git a/ReactNativeStaticServer.podspec b/ReactNativeStaticServer.podspec
index b28627525f0c2b187eaa74bbeb23c7668327b494..33899af089c2e9d928400f4af3a216977cfbbefd 100644
--- a/ReactNativeStaticServer.podspec
+++ b/ReactNativeStaticServer.podspec
@@ -56,6 +56,36 @@ Pod::Spec.new do |s|
     :output_files => $outputFiles,
     :script => <<-CMD
       set -e
+      CMAKE_BIN="$(command -v cmake || true)"
+      if [[ -z "$CMAKE_BIN" ]]; then
+        BREW_BIN="$(command -v brew || true)"
+        if [[ -z "$BREW_BIN" ]]; then
+          for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
+            if [[ -x "$candidate" ]]; then
+              BREW_BIN="$candidate"
+              break
+            fi
+          done
+        fi
+
+        if [[ -z "$BREW_BIN" ]]; then
+          echo "CMake is required to build react-native-static-server, but neither CMake nor Homebrew was found." >&2
+          exit 127
+        fi
+
+        CMAKE_PREFIX="$("$BREW_BIN" --prefix cmake 2>/dev/null || true)"
+        if [[ -z "$CMAKE_PREFIX" || ! -x "$CMAKE_PREFIX/bin/cmake" ]]; then
+          echo "Installing CMake with Homebrew for the iOS static server..."
+          HOMEBREW_NO_AUTO_UPDATE=1 "$BREW_BIN" install cmake
+          CMAKE_PREFIX="$("$BREW_BIN" --prefix cmake)"
+        fi
+        CMAKE_BIN="$CMAKE_PREFIX/bin/cmake"
+      fi
+
+      if [[ ! -x "$CMAKE_BIN" ]]; then
+        echo "CMake executable was not found at $CMAKE_BIN." >&2
+        exit 127
+      fi
 
       if [[ ${CONFIGURATION} == "Debug" ]]
       then
@@ -74,10 +104,10 @@ Pod::Spec.new do |s|
         EXTRA_CONFIG_ARGS="-DCMAKE_OSX_ARCHITECTURES=arm64;x86_64"
       fi
 
-      cmake ${PODS_TARGET_SRCROOT} -B ${TARGET_TEMP_DIR} \
+      "$CMAKE_BIN" ${PODS_TARGET_SRCROOT} -B ${TARGET_TEMP_DIR} \
         -DBUILD_STATIC=1 -DBUILD_LIBRARY=1 ${EXTRA_CONFIG_ARGS} #{$extraCMakeArgs}
 
-      cmake --build ${TARGET_TEMP_DIR} --config ${LIGHTTPD_CONFIG} --target lighttpd
+      "$CMAKE_BIN" --build ${TARGET_TEMP_DIR} --config ${LIGHTTPD_CONFIG} --target lighttpd
 
       cp  ${TARGET_TEMP_DIR}/lighttpd1.4/build${BUILD_OUTPUT_FOLDER_LIGHTTPD}/*.a \
           ${TARGET_TEMP_DIR}/pcre2${BUILD_OUTPUT_FOLDER_PCRE2}/*.a \
