modules = ["nodejs-24", "python-base-3.13", "java-graalvm22.3"]

[deployment]
router = "application"
deploymentTarget = "gce"
ignorePorts = false

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 19931
externalPort = 3000

[[ports]]
localPort = 25062
externalPort = 3002
exposeLocalhost = true

[[ports]]
localPort = 25063
externalPort = 3001

[nix]
channel = "stable-25_05"
packages = ["lighttpd"]

[userenv]

[userenv.shared]
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY = "goog_CgCGqoOXwRytrzUrGhkTaJVPhnI"
REVENUECAT_GOOGLE_PLAY_STORE_APP_ID = "app43da912671"
REVENUECAT_PROJECT_ID = "proj777f1aee"
