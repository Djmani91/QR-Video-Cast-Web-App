{
  "expo": {
    "name": "FrameCast Mobile",
    "slug": "framecast-mobile",
    "version": "1.1.9",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "framecast-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.framecast.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "FrameCast uses your local network to send media directly to the TV you paired.",
        "NSCameraUsageDescription": "FrameCast uses the camera to scan the pairing QR code on your TV."
      }
    },
    "android": {
      "package": "com.tvcast.com",
      "googleServicesFile": "./google-services.json",
      "versionCode": 20,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.CHANGE_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/with-firebase-android-only.cjs",
      "./plugins/with-background-casting.cjs",
      "./plugins/with-screen-audio-capture.cjs",
      "./plugins/with-android-upload-signing.cjs",
      "expo-router",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "FrameCast needs access to let you choose a photo or video to send to your TV.",
          "cameraPermission": "FrameCast uses the camera only to scan the TV pairing code.",
          "microphonePermission": "FrameCast uses Android playback capture to send supported app audio directly to your TV. It does not record microphone audio."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "FrameCast uses the camera only to scan the TV pairing code.",
          "microphonePermission": "FrameCast uses Android playback capture to send supported app audio directly to your TV during screen mirroring. It does not record microphone audio."
        }
      ],
      "expo-dev-client",
      "expo-video",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9928204391830083~4223166012",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
