{
  "expo": {
    "name": "FrameCast Mobile",
    "slug": "framecast-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "framecast-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.framecast.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "FrameCast uses your local network to send media directly to the TV you paired.",
        "NSCameraUsageDescription": "FrameCast uses the camera to scan the pairing QR code on your TV."
      }
    },
    "android": {
      "package": "com.tvcast.com",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.CHANGE_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/with-background-casting.cjs",
      "expo-router",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "FrameCast needs access to let you choose a photo or video to send to your TV.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "FrameCast uses the camera only to scan the TV pairing code.",
          "microphonePermission": "FrameCast does not record audio."
        }
      ],
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
