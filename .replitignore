# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
/generated-artifacts/

# Development caches are not needed by the production servers or static files.
/.cache/

# Uploaded debugging examples are not application assets or public content.
/attached_assets/

# Expo's production bundle does not need the generated native Android project.
# Keep this large Gradle/APK build output out of the deployment container.
/artifacts/framecast-mobile/android/

# Local APK builds also compile native dependencies inside node_modules.
# Production Metro bundles and Node servers do not use these generated caches.
**/android/build/
**/.cxx/
**/.gradle/
